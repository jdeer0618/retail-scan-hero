{
    "name": "ai-product-optimizer",
    "version": "1.0.0",
    "description": "Admin JS assets for AI Product Optimizer WordPress plugin",
    "private": true,
    "scripts": {
        "build": "webpack --mode=production",
        "dev": "webpack --mode=development --watch",
        "start": "webpack serve --mode=development",
        "test": "jest",
        "test:watch": "jest --watch",
        "lint": "eslint assets/js/admin",
        "lint:fix": "eslint assets/js/admin --fix"
    },
    "dependencies": {
        "@wordpress/api-fetch": "^7.0",
        "@wordpress/components": "^28.0",
        "@wordpress/compose": "^7.0",
        "@wordpress/data": "^10.0",
        "@wordpress/element": "^6.0",
        "@wordpress/hooks": "^4.0",
        "@wordpress/i18n": "^5.0",
        "@wordpress/notices": "^5.0",
        "@wordpress/plugins": "^7.0"
    },
    "devDependencies": {
        "@babel/core": "^7.24",
        "@babel/preset-env": "^7.24",
        "@babel/preset-react": "^7.24",
        "@testing-library/jest-dom": "^6.4",
        "@testing-library/react": "^16.0",
        "@wordpress/jest-preset-default": "^12.0",
        "@wordpress/scripts": "^30.0",
        "eslint": "^9.0",
        "jest": "^29.0",
        "webpack": "^5.94",
        "webpack-cli": "^5.1"
    },
    "jest": {
        "preset": "@wordpress/jest-preset-default",
        "testEnvironment": "jsdom",
        "setupFilesAfterFramework": [
            "@testing-library/jest-dom"
        ]
    }
}
