<?xml version="1.0"?>
<ruleset name="AI Product Optimizer">
    <description>WordPress Coding Standards for AI Product Optimizer</description>

    <!-- Scan these paths -->
    <file>src/</file>
    <file>tests/</file>
    <file>ai-product-optimizer.php</file>
    <file>uninstall.php</file>

    <!-- Exclude generated/vendor paths -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/assets/build/*</exclude-pattern>
    <exclude-pattern>*/tests/stubs/*</exclude-pattern>

    <!-- PHP version -->
    <config name="php_version" value="80300"/>

    <!-- WordPress text domain -->
    <config name="text_domain" value="ai-product-optimizer"/>

    <!-- Use WordPress-Extra (includes WordPress + WordPress-Core + WordPress-Docs) -->
    <rule ref="WordPress-Extra">
        <!-- Allow short array syntax []  -->
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
        <!-- Allow PSR-4 class filenames (class-* not required) -->
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    </rule>

    <!-- Enforce WordPress VIP coding practices for security -->
    <rule ref="WordPress.Security.EscapeOutput"/>
    <rule ref="WordPress.Security.NonceVerification"/>
    <rule ref="WordPress.DB.PreparedSQL"/>

    <!-- Minimum supported WP version (for deprecated function warnings) -->
    <config name="minimum_supported_wp_version" value="6.9"/>

    <!-- Enforce strict types declaration -->
    <rule ref="SlevomatCodingStandard.TypeHints.DeclareStrictTypes" phpcbf-only="false">
        <!-- Not installed by default, skip if not present -->
    </rule>

    <!-- Allow long lines in prompt template strings and SQL -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="200"/>
        </properties>
    </rule>
</ruleset>
